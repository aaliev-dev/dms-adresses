# Яндекс Карты: ключи API
# Кабинет разработчика: https://developer.tech.yandex.ru/
# Скопируйте этот файл в .env и вставьте свои ключи (в git .env не попадает).

# HTTP Геокодер — превращает адреса в координаты (нужен для геокодирования)
YANDEX_GEOCODER_KEY=

# JavaScript API — отрисовка карты на странице (клиентский ключ, попадает в HTML)
YANDEX_MAPS_JS_KEY=
